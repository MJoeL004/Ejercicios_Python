#Ejemplo de herencia en Python
class computer:

    def __init__(self, marca, color):
     self.marca = marca            
     self.color = color
  
#Ingreso de la herencia   
class Ordenador (computer):
    # Constructor
    
    def __init__(self, color, marca, modelo):
      super().__init__(marca, color)
      self.modelo = modelo
    # Método o Acciones
    def encender(self):
        print(f"El color del computador es {self.color}, la marca es {self.marca} y el modelo es {self.modelo}")
        print("El color del computador es", self.color,
              "Y la marca es", self.marca, "Y el modelo es", self. modelo)  
        
#Fuera de la clase 
#Instanciar la clase 
laptop = Ordenador("Verde", "Hp", "thinkpad")
laptop.encender()   


